# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (local Postgres for development) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/glideinbir?schema=public"

# --- App ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# --- Sessions ---
# Random 32+ byte secret used as a pepper when hashing session/reset tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-random-64-char-hex-string"

# --- Razorpay (server-only secrets; NEXT_PUBLIC_ key is the only one exposed to the browser) ---
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="replace-with-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="replace-with-razorpay-webhook-secret"
# "true" skips real Razorpay calls and lets a booking be "paid" with one
# click — for local testing only. Must be "false" (or unset) once real
# Razorpay keys are configured.
PAYMENT_DEMO_MODE="true"

# --- Storage ---
# "local" for development (files saved under /public/uploads).
# Switch to "cloudinary" or "s3" later without touching calling code.
STORAGE_DRIVER="local"
# CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# --- Email ---
EMAIL_PROVIDER="resend"
RESEND_API_KEY="replace-with-resend-api-key"
EMAIL_FROM="Glideinbir <bookings@glideinbir.com>"

# --- Initial Super Admin (read once by `npm run db:seed`) ---
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL="admin@glideinbir.com"
SUPER_ADMIN_PASSWORD="replace-with-a-strong-password"

# --- Cron (protects /api/cron/booking-reminders — see vercel.json) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET="replace-with-a-random-secret"

# --- Sahu Bhai (AI assistant) ---
# Leave SAHU_BHAI_API_KEY unset to keep the assistant disabled. Any
# OpenAI-compatible provider. Free tiers are all constrained in 2026:
#   Groq (free)  BASE_URL=https://api.groq.com/openai/v1   MODEL=openai/gpt-oss-120b
#                — 8k tokens/min, 1000 req/day. OK for low traffic; long chats
#                  can 413 (client trims history/tool results to reduce it).
#   Gemini free  — new 3.x flash models are ~20 requests/DAY. Not usable for
#                  a public bot. (older gemini-2.x flash is gone for new keys)
#   Groq PAID (pay-as-you-go) removes the per-minute wall — a small business
#     bot costs a few $/month. Same BASE_URL/MODEL, just a billed key.
#   Ollama (local, free, no key — set API_KEY to any non-empty string)
#                BASE_URL=http://localhost:11434/v1        MODEL=qwen2.5:3b
SAHU_BHAI_API_KEY=""
SAHU_BHAI_BASE_URL="https://api.groq.com/openai/v1"
SAHU_BHAI_MODEL="openai/gpt-oss-120b"

# --- Vapi voice assistant (optional) ---
# The "Talk" button on the Sahu Bhai widget stays hidden until BOTH are set.
# Both are browser-safe values from the Vapi dashboard (vapi.ai).
NEXT_PUBLIC_VAPI_PUBLIC_KEY=""
NEXT_PUBLIC_VAPI_ASSISTANT_ID=""

# --- Homepage flight video (optional) ---
# YouTube video id (the part after ?v=). When set, the homepage shows a
# "Watch a flight over Bir Billing" section with this video embedded.
NEXT_PUBLIC_FLIGHT_VIDEO_ID=""
