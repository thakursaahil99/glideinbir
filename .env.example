# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (local Postgres for development) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/glideinbir?schema=public"

# --- App ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# --- Sessions ---
# Random 32+ byte secret used as a pepper when hashing session/reset tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-random-64-char-hex-string"

# --- Razorpay (server-only secrets; NEXT_PUBLIC_ key is the only one exposed to the browser) ---
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="replace-with-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="replace-with-razorpay-webhook-secret"
# "true" skips real Razorpay calls and lets a booking be "paid" with one
# click — for local testing only. Must be "false" (or unset) once real
# Razorpay keys are configured.
PAYMENT_DEMO_MODE="true"

# --- Storage ---
# "local" for development (files saved under /public/uploads).
# Switch to "cloudinary" or "s3" later without touching calling code.
STORAGE_DRIVER="local"
# CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# --- Email ---
EMAIL_PROVIDER="resend"
RESEND_API_KEY="replace-with-resend-api-key"
EMAIL_FROM="Glideinbir <bookings@glideinbir.com>"

# --- Initial Super Admin (read once by `npm run db:seed`) ---
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL="admin@glideinbir.com"
SUPER_ADMIN_PASSWORD="replace-with-a-strong-password"

# --- Cron (protects /api/cron/booking-reminders — see vercel.json) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET="replace-with-a-random-secret"
